generator client {
  provider = "prisma-client-js"
  // provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
}

model user {
  id         String      @id @unique @default(uuid())
  clerkId    String      @unique
  name       String
  email      String      @unique
  createdAt DateTime @default(now())
  workspaces workspace[]

  @@index([clerkId])
}

model workspace {
  id          String     @id @unique @default(uuid())
  name        String
  ownerId     String
  createdAt   DateTime   @default(now())
  description String
  color       String
  user        user       @relation(fields: [ownerId], references: [id])
  workflows   workflow[]

@@index([ownerId])
}

model workflow {
  id               String            @id @default(uuid())
  name             String
  description      String
  isEnabled        Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  workspaceId      String
  workspace       workspace       @relation(fields: [workspaceId], references: [id])

  currentVersionId String?           @unique
  currentVersion workflowVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])


  executions       execution[]
  versions         workflowVersion[] @relation("AllVersions")

  @@index([workspaceId])
}

model workflowVersion {
  id            String      @id @default(uuid())
  versionNumber Int
  graph         Json
  createdAt     DateTime    @default(now())

  workflowId    String
  workflow workflow @relation("AllVersions", fields: [workflowId], references: [id])

  currentFor     workflow?   @relation("CurrentVersion")
  executions    execution[]

@@unique([workflowId, versionNumber])
@@index([workflowId])
}

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum TriggerType {
  API
  MANUAL
  RETRY
}

model execution {
  id            String          @id @default(uuid())
  status        ExecutionStatus @default(PENDING)
  triggeredBy   TriggerType @default(API)
input Json?
output Json?
error String?
  totalDuration Int?
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?

  workflowId    String
  workflow        workflow        @relation(fields: [workflowId], references: [id])

  versionId     String
  version workflowVersion @relation(fields: [versionId], references: [id])

  nodeExecutions  nodeExecution[]

  @@index([workflowId])
  @@index([versionId])
  @@index([status])
  @@index([startedAt])
}

enum nodeExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

model nodeExecution {
  id          String          @id @default(uuid())
  nodeId      String
  nodeType    String
  executionId String
  status      nodeExecutionStatus @default(PENDING)
  input       Json
  output      Json?
  error       String?
  startedAt   DateTime        @default(now())
  finishedAt  DateTime?
  execution   execution       @relation(fields: [executionId], references: [id])

  @@index([executionId])
  @@index([nodeId])
  @@index([status])
}

